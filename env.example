# TurnCall Configuration
# Copy this file to .env and fill in your values
TURNCALL_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://turncall:turncall@localhost:5432/turncall

# Redis
REDIS_URL=redis://localhost:6379/0

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# OpenAI (LLM + TTS) — not required if using Ollama/custom LLM
OPENAI_API_KEY=

# Deepgram (streaming STT/TTS — get free key at console.deepgram.com)
DEEPGRAM_API_KEY=

# ElevenLabs (STT/TTS — get key at elevenlabs.io)
ELEVENLABS_API_KEY=

# Google (Gemini Live S2S — get key at aistudio.google.com)
GOOGLE_API_KEY=

# Anthropic (Claude LLM — get key at console.anthropic.com)
ANTHROPIC_API_KEY=

# Cartesia (Sonic TTS + Ink STT — get key at play.cartesia.ai)
CARTESIA_API_KEY=

# OpenRouter (multi-model LLM + fallback routing — get key at openrouter.ai/keys)
OPENROUTER_API_KEY=

# HeyGen (video avatar for WebRTC calls — get key at HeyGen dashboard)
HEYGEN_LIVE_AVATAR_API_KEY=

# Tavus (video avatar for WebRTC calls — get key at platform.tavus.io)
TAVUS_API_KEY=

# WhatsApp Business (voice calling + text messaging)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Local Storage (dev mode)
LOCAL_STORAGE_PATH=./storage

# Server
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info
# Public https base URL for Twilio callbacks issued without an inbound request
# (warm-transfer briefing + no-answer fallback). e.g. https://abc.ngrok.io
# Also read by the examples' run.sh launchers as the --server-url value.
# PUBLIC_BASE_URL=

# Dev tooling — read by examples/*/run.sh and scripts/seed_dev.sh (not by the server)
# TURNCALL_NUMBER=+15551234567          # your Twilio number, E.164
# TWILIO_PN_SID=PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # its Phone Number SID

# Observability (OpenTelemetry tracing + pipeline observers) — see adr/0010
# Both default ON in every environment. Tracing exports spans to an OTLP backend;
# in production it self-disables without an endpoint (never console-exports).
# PIPECAT_ENABLE_OBSERVERS=true     # log latency/turn/LLM/transcription/startup
# PIPECAT_ENABLE_TRACING=true
# PIPECAT_TRACE_INCLUDE_PII=true    # put from/to phone numbers on spans
# PIPECAT_OTEL_SERVICE_NAME=turncall
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # required for tracing in prod
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf           # or grpc
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer xxx

# Webhook Signing
WEBHOOK_SIGNING_SECRET=

# BYOM (Bring Your Own Model) — optional, for custom LLM providers
# BYOM_ENABLED=true
# BYOM_ALLOWED_URL_PATTERNS=["http://localhost:*","https://*.together.xyz/*"]

# API
API_KEY_HASH_SECRET=change-me-in-production
# Platform credential gating project/first-key creation (only the builder holds
# it; sent as the X-Platform-Key header). Empty = gate fails closed, rejecting all.
# Dev default so examples/seed scripts work out of the box — set a strong unique
# value in production.
PLATFORM_API_KEY=dev-platform-key

# --- AWS Bedrock / Nova Sonic (adr/0016) ---
# Default region for the `bedrock` LLM and `aws` S2S providers. Also used by S3.
# Per-agent config.aws.region overrides it.
AWS_REGION=us-east-1
# Credentials for Bedrock / Nova Sonic. Leave blank on a host that already has
# them (an EC2 instance profile, ECS task role, or EKS IRSA) — the resolver
# picks those up. Inside Docker they must be set here: ~/.aws is not mounted
# into the container, so an SSO profile on your laptop is not visible to it.
# Blank is also fine when you only use LocalStack S3.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=       # only for temporary credentials
# Allow per-agent *static* AWS keys. They land in config_blob (unencrypted
# JSONB), so this is off by default; prefer config.aws.role_arn, which stores no
# durable secret. Credentials otherwise come from the ambient chain: env vars, an
# SSO profile, an instance profile, or IRSA.
AWS_AGENT_CREDENTIALS_ENABLED=false
